{minimum_otp_vsn, "27"}.

{deps, [
    gun
]}.

{project_plugins, [
    rebar3_ex_doc,
    covertool,
    {rebar3_gpb_plugin, "2.23.2"},
    %% Temporary: the enhance branch, until a release has client_type and method_meta_type.
    {rebar3_egrpc_plugin, {git, "https://github.com/belltoy/rebar3_egrpc_plugin.git", {branch, "enhance"}}}
]}.

%% Coverage: `rebar3 do eunit, ct, covertool generate' writes the Cobertura report to
%% `_build/test/covertool/egrpc.covertool.xml'. The generated modules are not counted.
{cover_enabled, true}.
{cover_export_enabled, true}.
{cover_excl_mods, [
    egrpc_health_pb,
    egrpc_reflection_v1_pb,
    egrpc_reflection_v1alpha_pb,
    egrpc_grpc_health_v1_health_client,
    egrpc_grpc_reflection_v1_server_reflection_client,
    egrpc_grpc_reflection_v1alpha_server_reflection_client
]}.
{covertool, [
    {coverdata_files, ["eunit.coverdata", "ct.coverdata"]}
]}.

{gpb_opts, [
    {module_name_prefix, "egrpc_"},
    {module_name_suffix, "_pb"},
    {recursive, true},

    {json, true},
    {json_format, maps},
    {json_object_format, map},
    {json_key_format, atom},
    {json_array_format, list},
    {json_string_format, binary},
    {json_null, undefined},

    {i, "priv/protos/"},
    {ipath, "_build/default/plugins/gpb/priv/proto3/"},
    {ipath, "priv/protos/"},
    use_packages,
    {o_erl, "src/protos"},
    {o_hrl, "include"},
    {strings_as_binaries, true},
    maps,
    {maps_unset_optional, omitted},
    type_specs
]}.

{egrpc_opts, [
    {out_dir, "src/clients"},
    {module_name_prefix, "egrpc_"},
    {module_name_suffix, "_client"},
    {protos, "priv/protos/"},
    {client_type, "egrpc:channel()"},
    {method_meta_type, "egrpc:method_meta()"}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    warnings_as_errors,
    deprecated_functions
]}.

{xref_ignores, [
    egrpc_health_pb,
    egrpc_reflection_v1_pb,
    egrpc_reflection_v1alpha_pb
]}.

{profiles, [
    {dev, [
        {provider_hooks, [
            {pre, [
                {compile, {protobuf, compile}},
                {clean, {protobuf, clean}}
            ]}
        ]}
    ]},
    {test, [
        %% A fake gRPC server for the Common Test suites, see test/egrpc_fake_server.erl.
        {deps, [{cowboy, "2.12.0"}]}
    ]}
]}.

{shell, [
    % {config, "config/sys.dev.config"},
    {apps, [egrpc]}
]}.

{dialyzer, [
    {plt_extra_apps, [ssl, public_key]}
]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [
    {source_url, <<"https://github.com/belltoy/egrpc">>},
    {extras, [<<"README.md">>, <<"LICENSE.md">>]},
    {main, <<"readme">>},
    {groups_for_modules, [
        {<<"System">>, [
            egrpc,
            egrpc_codec,
            egrpc_error,
            egrpc_grpc,
            egrpc_stream,
            egrpc_interceptor,
            egrpc_stub
        ]},
        {<<"Codec">>, [
            egrpc_erlpack,
            egrpc_json,
            egrpc_proto
        ]},
        {<<"Clients">>, [
            egrpc_grpc_health_v1_health_client,
            egrpc_grpc_reflection_v1_server_reflection_client,
            egrpc_grpc_reflection_v1alpha_server_reflection_client
        ]}
    ]}
]}.
